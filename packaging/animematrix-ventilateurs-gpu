#!/usr/bin/python3 -I
"""Assistant root d'AniMe Matrix : vitesse des ventilateurs d'une carte NVIDIA (NVML exige root).

    animematrix-ventilateurs-gpu <index> <pourcentage 0-100 | auto>

Lancé par le démon via `sudo -n` (règle facultative share/.../sudoers/animematrix-ventilateurs) ;
ne fait rien d'autre, arguments vérifiés strictement.
"""
import ctypes
import re
import sys

# Chiffres ASCII seulement : str.isdigit() accepte aussi des chiffres Unicode (« ² ») que int() refuse.
NOMBRE = re.compile(r"[0-9]{1,3}")


def main(argv) -> int:
    if len(argv) != 2 or not NOMBRE.fullmatch(argv[0]) or not (argv[1] == "auto" or NOMBRE.fullmatch(argv[1])):
        print("usage : animematrix-ventilateurs-gpu <index> <0-100|auto>", file=sys.stderr)
        return 2
    index, value = int(argv[0]), argv[1]
    lib = ctypes.CDLL("libnvidia-ml.so.1")
    if lib.nvmlInit_v2():
        print("NVML : initialisation refusée", file=sys.stderr)
        return 1
    try:
        h, n = ctypes.c_void_p(), ctypes.c_uint()
        if lib.nvmlDeviceGetHandleByIndex_v2(index, ctypes.byref(h)) or lib.nvmlDeviceGetNumFans(h, ctypes.byref(n)):
            print(f"carte NVIDIA {index} introuvable", file=sys.stderr)
            return 1
        lo, hi = ctypes.c_uint(0), ctypes.c_uint(100)
        lib.nvmlDeviceGetMinMaxFanSpeed(h, ctypes.byref(lo), ctypes.byref(hi))
        for fan in range(n.value):
            if value == "auto":
                rc = lib.nvmlDeviceSetDefaultFanSpeed_v2(h, fan)
            else:
                rc = lib.nvmlDeviceSetFanSpeed_v2(h, fan, max(lo.value, min(hi.value, int(value))))
            if rc:
                print(f"NVML : ventilateur {fan} de la carte {index} refusé (code {rc})", file=sys.stderr)
                return 1
        return 0
    finally:
        lib.nvmlShutdown()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
